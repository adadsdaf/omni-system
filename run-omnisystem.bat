@echo off
title نظام حسابات ومبيعات مخابز الشام - إتقان سوفت
chcp 65001 > nul
cls

echo =======================================================================
echo          نظام حسابات ومبيعات مخابز الشام - إتقان سوفت (itQAN Sft)
echo                 محرك التشغيل التلقائي الذكي لنظام ويندوز
echo =======================================================================
echo.

:: 1. التحقق من فك ضغط مجلد المشروع بالكامل أولاً
if not exist "package.json" (
    color 0c
    echo [خطأ فادح]: يرجى فك ضغط مجلد المشروع بالكامل أولاً قبل تشغيل النظام!
    echo لا يمكن تشغيل النظام من داخل ملف الـ ZIP مباشرة.
    echo.
    pause
    exit /b
)

:: 2. التحقق من وجود Node.js مثبت على الكمبيوتر
echo [1/4] جاري التحقق من وجود بيئة تشغيل Node.js...
where node >nul 2>nul
if errorlevel 1 (
    color 0c
    echo -------------------------------------------------------------------
    echo [خطأ]: لم يتم العثور على برنامج Node.js مثبت على هذا الجهاز!
    echo.
    echo لكي يعمل النظام، يرجى تحميل وتثبيت Node.js (الإصدار 18 أو 20 أو أحدث) من الرابط التالي:
    echo https://nodejs.org/
    echo ثم أعد تشغيل هذا الملف بعد تثبيته.
    echo -------------------------------------------------------------------
    pause
    exit /b
)
echo [نجاح]: Node.js مثبت وجاهز للعمل.
echo.

:: 3. التحقق من وجود المجلدات البرمجية وتثبيتها إذا لم تكن موجودة
echo [2/4] جاري التحقق من ملفات النظام وقاعدة البيانات (node_modules)...
if not exist "node_modules" (
    echo [معلومات]: يتم التثبيت لأول مرة. جاري تحميل الملحقات البرمجية وقاعدة البيانات...
    echo يرجى الانتظار لبضع دقائق (تحدث لمرة واحدة فقط)...
    call npm install
    if errorlevel 1 (
        color 0c
        echo [خطأ]: فشل تثبيت الملحقات البرمجية. يرجى التأكد من اتصال الإنترنت وحاول مجدداً.
        pause
        exit /b
    )
    echo [نجاح]: تم تثبيت الحزم بنجاح.
) else (
    echo [نجاح]: ملفات الملحقات البرمجية جاهزة.
)
echo.

:: 4. التحقق من وجود ملفات الواجهات والسيرفر المبنية
echo [3/4] جاري التحقق من بناء الواجهات (dist)...
if not exist "dist" (
    echo [معلومات]: جاري بناء وتجميع النظام والواجهات للمرة الأولى...
    call npm run build
    if errorlevel 1 (
        color 0c
        echo [خطأ]: فشل بناء وتجميع النظام.
        pause
        exit /b
    )
    echo [نجاح]: تم بناء النظام بنجاح.
) else (
    echo [نجاح]: ملفات البناء جاهزة ومحدثة مسبقاً.
)
echo.

:: 5. إنشاء اختصار على سطح المكتب تلقائياً إذا لم يكن موجوداً
if not exist "%USERPROFILE%\Desktop\نظام مخابز الشام - إتقان سوفت.lnk" (
    echo [معلومات]: جاري إنشاء اختصار سريع ومباشر على سطح المكتب الخاص بك...
    set SCRIPT="%TEMP%\%RANDOM%-%RANDOM%.vbs"
    echo Set oWS = CreateObject("WScript.Shell") >> %SCRIPT%
    echo sLinkFile = oWS.SpecialFolders("Desktop") ^& "\نظام مخابز الشام - إتقان سوفت.lnk" >> %SCRIPT%
    echo Set oLink = oWS.CreateShortcut(sLinkFile) >> %SCRIPT%
    echo oLink.TargetPath = "%~dp0run-omnisystem.bat" >> %SCRIPT%
    echo oLink.WorkingDirectory = "%~dp0" >> %SCRIPT%
    echo oLink.Description = "نظام الحسابات والمبيعات لمخابز الشام - إتقان سوفت" >> %SCRIPT%
    echo oLink.IconLocation = "%SystemRoot%\System32\shell32.dll,147" >> %SCRIPT%
    echo oLink.Save >> %SCRIPT%
    cscript /nologo %SCRIPT% > nul 2>&1
    del %SCRIPT% > nul 2>&1
    echo [نجاح]: تم إنشاء الاختصار بنجاح على سطح المكتب باسم "نظام مخابز الشام - إتقان سوفت"!
    echo.
)

:: 6. تشغيل السيرفر وفتح النظام تلقائياً بالمتصفح
echo [4/4] جاري بدء تشغيل سيرفر مخابز الشام على المنفذ المحلي 3000...
echo -------------------------------------------------------------------
echo         🚀 نظام مخابز الشام متاح الآن!
echo         🔗 رابط الدخول المباشر: http://localhost:3000/pos
echo.
echo         * يرجى إبقاء هذه النافذة السوداء مفتوحة أثناء استخدامك للنظام.
echo         * تم إنشاء اختصار للنظام على سطح المكتب لتسهيل وصولك مستقبلاً!
echo         * لإيقاف السيرفر بأمان، قم بإغلاق هذه النافذة فقط.
echo -------------------------------------------------------------------
echo.

:: تشغيل المتصفح لفتح الرابط تلقائياً
start "" "http://localhost:3000/pos"

:: تشغيل السيرفر مباشرة
node dist/server.cjs

pause
